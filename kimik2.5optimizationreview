// utils/performanceMonitor.ts
class PerformanceMonitor {
  private metrics: Map<string, MetricSeries> = new Map();
  
  recordLatency(operation: string, duration: number): void {
    if (!this.metrics.has(operation)) {
      this.metrics.set(operation, new MetricSeries());
    }
    this.metrics.get(operation)!.add(duration);
  }
  
  getStats(operation: string): LatencyStats {
    const series = this.metrics.get(operation);
    if (!series) return { p50: 0, p95: 0, p99: 0, count: 0 };
    
    return {
      p50: series.percentile(50),
      p95: series.percentile(95),
      p99: series.percentile(99),
      count: series.count
    };
  }
  
  exportMetrics(): string {
    const lines: string[] = [];
    for (const [op, series] of this.metrics.entries()) {
      lines.push(`# HELP solvent_${op}_latency Latency in ms`);
      lines.push(`# TYPE solvent_${op}_latency summary`);
      lines.push(`solvent_${op}_latency_count ${series.count}`);
      lines.push(`solvent_${op}_latency_sum ${series.sum}`);
    }
    return lines.join('\n');
  }
}

