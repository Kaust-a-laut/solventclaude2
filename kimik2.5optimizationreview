// contextService.ts - Incremental BM25 updates
class IncrementalBM25Index {
  private index: BM25Index;
  private docCount: number = 0;
  private lastUpdate: number = 0;
  
  async updateIncrementally(newEntries: VectorEntry[]): Promise<void> {
    const entriesToAdd = newEntries.filter(e => 
      !this.indexedIds.has(e.id)
    );
    
    if (entriesToAdd.length > 0) {
      entriesToAdd.forEach(entry => {
        this.index.addDocument(entry.id, entry.metadata.text);
        this.indexedIds.add(entry.id);
      });
      this.lastUpdate = Date.now();
    }
  }
  
  shouldRebuild(): boolean {
    return (this.indexedIds.size - this.docCount) / this.docCount > 0.2;
  }
}
