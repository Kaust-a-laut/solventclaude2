// pluginManager.ts - Parallel initialization with health checks
async initialize(): Promise<InitializationResult> {
  if (this.isInitialized) return { success: true };
  
  const results: PluginResult[] = [];
  
  // Load all plugins in parallel
  const loadPromises = [
    this.loadProviderPlugins(),
    this.loadToolPlugins()
  ];
  
  const [providers, tools] = await Promise.allSettled(loadPromises);
  
  // Initialize plugins in parallel with timeout
  const initPromises = [
    ...this.registry.providers.values(),
    ...this.registry.tools.values()
  ].map(async plugin => {
    if (!plugin.initialize) return { id: plugin.id, success: true };
    
    try {
      await Promise.race([
        plugin.initialize({}),
        new Promise((_, reject) => 
          setTimeout(() => reject(new Error('Timeout')), 5000)
        )
      ]);
      return { id: plugin.id, success: true };
    } catch (error) {
      logger.error(`[PluginManager] Failed to initialize ${plugin.id}`, error);
      return { id: plugin.id, success: false, error };
    }
  });
  
  const initResults = await Promise.all(initPromises);
  
  this.isInitialized = true;
  
  return {
    success: initResults.every(r => r.success),
    results: initResults
  };
}
