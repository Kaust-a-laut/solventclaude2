// Add to config.ts
export const CONNECTION_POOLS = {
  REDIS: { min: 2, max: 10, acquireTimeout: 5000 },
  AI_PROVIDERS: { maxConcurrent: 5, queueSize: 20 }
};

// Implement in aiProviderFactory.ts
class ProviderConnectionPool {
  private semaphore: number = CONNECTION_POOLS.AI_PROVIDERS.maxConcurrent;
  private queue: Array<() => void> = [];
  
  async acquire(): Promise<void> {
    if (this.semaphore > 0) {
      this.semaphore--;
      return;
    }
    return new Promise(resolve => this.queue.push(resolve));
  }
  
  release(): void {
    if (this.queue.length > 0) {
      const next = this.queue.shift()!;
      next();
    } else {
      this.semaphore++;
    }
  }
}
