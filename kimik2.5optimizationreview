// vectorService.ts - Multi-tier search strategy
async searchOptimized(
  query: string, 
  limit: number = 5,
  options: SearchOptions = {}
): Promise<SearchResult[]> {
  const startTime = Date.now();
  
  // Tier 1: HNSW fast approximate search
  if (this.useHNSW && !options.filters && limit <= 10) {
    const hnswResults = await this.searchHNSW(query, limit * 2);
    if (hnswResults.length >= limit) {
      memoryMetrics.recordHNSWHit();
      return hnswResults.slice(0, limit);
    }
  }
  
  // Tier 2: Filtered index search
  if (options.filters?.type && this.typeIndex.has(options.filters.type)) {
    const candidateIds = this.typeIndex.get(options.filters.type)!;
    return this.bruteForceSearchWithIds(query, candidateIds, limit);
  }
  
  // Tier 3: Full brute force
  return this.searchBruteForce(query, limit, options);
}

// Async HNSW initialization
async initializeHNSW(): Promise<void> {
  if (!this.hnswIndex) {
    this.hnswIndex = new HNSWIndex(768, config.MEMORY_MAX_ENTRIES + 500);
    
    // Build in background chunks
    const chunkSize = 100;
    for (let i = 0; i < this.memory.length; i += chunkSize) {
      const chunk = this.memory.slice(i, i + chunkSize);
      await new Promise(resolve => setImmediate(resolve));
      chunk.forEach(entry => this.hnswIndex!.add(entry.id, entry.vector));
    }
  }
}
